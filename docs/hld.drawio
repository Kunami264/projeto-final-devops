        <mxCell id="envs" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=13;fontStyle=1;fontColor=#1F2937;startSize=32;rounded=1;arcSize=4;swimlaneFillColor=#FFFFFF;shadow=0;" value="🧭  Ambientes" vertex="1">
